// Fintarg data model.
//
// Money is stored as an Int in LKR *cents* (1 rupee = 100 cents) so that every
// financial calculation in src/lib/finance is exact integer arithmetic. Never
// introduce Float for money.
//
// PostgreSQL is the only supported database. The schema previously ran on SQLite
// and was applied with `prisma db push`, so there is no migration history to
// preserve: the first entry in prisma/migrations/ is the complete baseline.
// Production applies it with `prisma migrate deploy` (see DEPLOY.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// How a user runs their finances.
///
/// This is deliberately NOT the same thing as `plan` (`src/lib/plans.ts`).
/// Mode decides which financial context a screen talks to; plan decides which
/// features are unlocked. A salary-mode user on the Business plan is normal,
/// and so is a business-mode user on the free plan.
enum UserMode {
  salary
  business
  both
}

model User {
  id           String    @id @default(cuid())
  /// Nullable so an account can be created with only a mobile number (FR-1.1).
  /// Both identifiers are optional individually, but at least one is required
  /// by `registerSchema`.
  email        String?   @unique
  mobile       String?   @unique
  passwordHash String
  /// Entitlement tier, NOT the product mode. Kept as a String because
  /// `src/lib/plans.ts` resolves it against the admin-editable PlanFeature
  /// table, whose keys are rows rather than compile-time constants.
  edition      String    @default("basic") // "basic" | "business" (see src/lib/plans.ts)
  plan         String    @default("free") // internal plan key, feature flags derive from this
  /// Which financial contexts this user works in. Independent of `plan`.
  /// Legacy accounts were mapped basic -> salary, business -> business
  /// (scripts/migrate-editions.ts); nobody is mapped to `both` automatically,
  /// because doing so would imply business records they may not have.
  mode         UserMode  @default(salary)
  /// "user" | "admin" (FR-1.6). Admins manage accounts, never financial content.
  role         String    @default("user")
  /// PDPA No. 9 of 2022 consent, captured at registration (NFR-7).
  consentAt    DateTime?
  consentVersion String?
  emailVerifiedAt DateTime?
  /// Persistent lock-out (NFR-5): 8 failed sign-ins pauses the account 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  suspendedAt  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile        Profile?
  sessions       Session[]
  contacts       Contact[]
  documents      Document[]
  incomes        Income[]
  expenses       Expense[]
  categories     ExpenseCategory[]
  financePayments FinancePayment[]
  loans          Loan[]
  pawnedItems    PawnedItem[]
  savingsGoals   SavingsGoal[]
  contributions  Contribution[]
  spendPlans     PersonalSpendingPlan[]
  businesses     Business[]
  ownerDraws     OwnerDraw[]
  businessSales    BusinessSale[]
  businessCosts    BusinessCost[]
  businessPayments BusinessPayment[]
  businessLoans    BusinessLoan[]
  businessTargets  BusinessTarget[]
  letters        Letter[]
  agreements     Agreement[]
  medicalRecords MedicalRecord[]
  reminders      Reminder[]
  deletionRequests DeletionRequest[]
  auditLogs      AuditLog[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  subscriptions       Subscription[]

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  /// Set when the password was re-entered. Restricted vault downloads require a
  /// fresh sign-in within 30 minutes (FR-12.5).
  reauthAt     DateTime?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  userAgent    String?
  ip           String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time password reset (FR-1.3). Only the SHA-256 hash is stored, so a
/// database leak cannot be replayed against the reset endpoint.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time email/mobile verification. Optional: it never blocks sign-in.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String    @default("email") // "email" | "mobile"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Admin-editable feature flags (FR-15.1). `PLAN_MATRIX` in `src/lib/plans.ts`
/// stays the code default; a row here overrides it for that plan, so a feature
/// can be switched off without a deploy.
model PlanFeature {
  plan    String
  feature String
  enabled Boolean  @default(true)

  @@id([plan, feature])
  @@index([plan])
}

/// One subscription attempt against a payment gateway (FR-15 upgrade path).
///
/// The gateway, not this app, is the authority on whether money arrived: the plan
/// is only moved to `paid` by a **signature-verified webhook**, never by the browser
/// returning from checkout. That is the whole reason this table exists.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  plan                 String // "business"
  provider             String // "stripe" | "payhere" | "log"
  providerSessionId    String?   @unique
  providerPaymentId    String?
  /// In LKR cents. Integer, like every other money value in this schema.
  amountCents          Int
  status               String    @default("pending") // "pending" | "paid" | "failed" | "cancelled" | "refunded"
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  paidAt               DateTime?
  /// Set when a charge is later reversed, so the plan can be walked back.
  cancelledAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  fullName    String?
  mobile      String?
  address     String?
  dateOfBirth DateTime?
  nicNumber   String?
  portfolioUrl String?
  // Appearance (FR-8) - stored per account, synced across devices.
  themeAccent String   @default("#0f766e")
  themeMode   String   @default("system") // "light" | "dark" | "system"
  fontScale   String   @default("medium") // "small" | "medium" | "large"
  density     String   @default("comfortable") // "comfortable" | "compact"
  /// Reminders are email by default; the user can turn them off or change how
  /// far ahead they are notified.
  remindersEnabled Boolean @default(true)
  reminderLeadDays  Int     @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String?
  phone        String
  kind         String   @default("personal") // "personal" | "family"
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id           String   @id @default(cuid())
  userId       String
  category     String // "profile" | "cv" | "nic" | "bank" | "medical" | "other" | "letter" | "agreement"
  label        String
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  note         String?
  sensitivity  String   @default("standard") // "standard" | "sensitive" | "restricted"
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model ExpenseCategory {
  id         String   @id @default(cuid())
  userId     String? // null = built-in category shared by every account
  name       String
  sortOrder  Int      @default(0)
  isDefault  Boolean  @default(false)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
}

model Income {
  id         String    @id @default(cuid())
  userId     String
  sourceName String
  kind       String // "salary" | "business" | "other"
  amountCents Int
  frequency  String    @default("monthly") // "monthly" | "one_time" | "custom"
  date       DateTime
  recurring  Boolean   @default(false)
  customIntervalDays Int?
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Expense {
  id          String    @id @default(cuid())
  userId      String
  date        DateTime
  amountCents Int
  categoryId  String?
  categoryName String
  note        String?
  recurring   Boolean   @default(false)
  isMedical   Boolean   @default(false)
  isPersonal  Boolean   @default(false) // counts against the planned personal allowance
  /// Set when this expense was booked from a Medical record, so deleting the
  /// record also removes its money from the monthly analysis.
  medicalRecordId String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryName])
}

model FinancePayment {
  id              String    @id @default(cuid())
  userId          String
  lender          String
  description     String
  amountCents     Int
  dueDayOfMonth   Int
  monthsRemaining Int?
  startDate       DateTime  @default(now())
  active          Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model Loan {
  id                   String    @id @default(cuid())
  userId               String
  lender               String
  purpose              String?
  principalCents       Int
  interestRatePct      Float     @default(0)
  method               String    @default("reducing") // "flat" | "reducing" | "simple"
  startDate            DateTime
  dueDate              DateTime?
  remainingBalanceCents Int
  // Manual interest is used when the user records a fixed monthly interest amount.
  manualMonthlyInterestCents Int?
  notes                String?
  sourceRef            String? // e.g. "shortfall" when created from a monthly shortfall
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

model PawnedItem {
  id                    String    @id @default(cuid())
  userId                String
  description           String
  amountReceivedCents   Int
  interestRatePct       Float     @default(0)
  monthlyInterestCents  Int       @default(0)
  nextInterestDueDate   DateTime?
  redemptionDate        DateTime?
  notes                 String?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextInterestDueDate])
}

model SavingsGoal {
  id                String    @id @default(cuid())
  userId            String
  name              String
  targetAmountCents Int
  endDate           DateTime?
  mode              String    @default("daily") // "daily" | "monthly"
  dailyAmountCents  Int       @default(0)
  monthlyTargetCents Int      @default(0)
  note              String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@index([userId, deletedAt])
}

model Contribution {
  id          String   @id @default(cuid())
  userId      String
  goalId      String
  date        DateTime @default(now())
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([goalId])
}

model PersonalSpendingPlan {
  id              String   @id @default(cuid())
  userId          String
  month           String // "YYYY-MM"
  plannedAmountCents Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

/// One trading entity owned by a user.
///
/// This model is the former `Company` (letterhead for company letters) renamed
/// and extended rather than replaced, so every existing row migrates across
/// with its name, registration number and accent colour intact. The letterhead
/// columns stay because company-branded letters still need them.
model Business {
  id           String   @id @default(cuid())
  userId       String
  name         String
  regNumber    String?
  address      String?
  phone        String?
  email        String?
  accentColor  String?
  logoStoredName String?
  /// First day of trading. Used to label trends; not used in any calculation.
  startedOn    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches  Branch[]
  sales     BusinessSale[]
  costs     BusinessCost[]
  payments  BusinessPayment[]
  loans     BusinessLoan[]
  targets   BusinessTarget[]
  ownerDraws OwnerDraw[]
  letters   Letter[]
  agreements Agreement[]

  @@index([userId])
  @@index([userId, deletedAt])
}

/// A trading location within a business. Sales and costs may be attributed to
/// a branch, or left null to mean "the whole business".
///
/// Ownership is transitive: branch -> business -> user. Every read must still
/// scope through the owning user, never by branchId alone.
model Branch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  phone      String?
  /// A closed branch keeps its history but cannot take new records.
  isActive   Boolean  @default(true)
  openedOn   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales     BusinessSale[]
  costs     BusinessCost[]
  payments  BusinessPayment[]
  loans     BusinessLoan[]
  targets   BusinessTarget[]

  @@index([businessId])
  @@index([businessId, deletedAt])
}

/// Money taken in by trading. The business-side counterpart of `Income`, kept
/// separate so personal salary can never be mixed into a profit figure.
model BusinessSale {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  branchId    String?
  date        DateTime
  amountCents Int
  /// "cash" | "card" | "credit" | "transfer" - how the money arrived.
  channel     String?
  description String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([businessId, date])
  @@index([branchId, date])
}

/// Running cost of trading. `category` is free text on purpose: the set of costs
/// a hardware shop and a bakery pay for has no fixed upper bound, so an enum
/// here would need a migration every time a user invents a new one.
model BusinessCost {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  branchId    String?
  date        DateTime
  amountCents Int
  category    String // "rent" | "wages" | "utilities" | "stock" | "transport" | ...
  description String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([businessId, date])
  @@index([branchId, date])
}

/// A recurring business obligation - rent, a supplier, a lease. The business
/// counterpart of `FinancePayment`, and deliberately not the same row: mixing a
/// shop's rent into personal obligations would corrupt both totals.
model BusinessPayment {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  branchId    String?
  title       String
  amountCents Int
  /// "monthly" | "weekly" | "quarterly" | "yearly" | "once"
  frequency   String   @default("monthly")
  dueDayOfMonth Int?
  startDate   DateTime
  /// Total instalments, matching `FinancePayment.monthsRemaining` semantics.
  monthsRemaining Int?
  active      Boolean  @default(true)
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@index([businessId, startDate])
}

/// A liability the business owes. Field-for-field the same shape as the
/// personal `Loan` so both can be fed to the same interest calculation in
/// `src/lib/finance/analysis.ts` rather than duplicating the formula.
model BusinessLoan {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  branchId    String?
  title       String
  principalCents Int
  remainingBalanceCents Int
  interestRatePct Float @default(0)
  /// "flat" | "reducing" | "simple" | "compound"
  method      String   @default("reducing")
  startDate   DateTime
  dueDate     DateTime?
  manualMonthlyInterestCents Int?
  /// "shortfall" when the loan was created from a business shortfall.
  sourceRef   String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([businessId, startDate])
}

/// A revenue or profit goal for a business or one of its branches.
///
/// `month` is a "YYYY-MM" key, matching the existing `PersonalSpendingPlan`
/// convention rather than inventing a second notion of "which month".
///
/// The unique constraint covers branch-scoped targets. PostgreSQL treats NULLs
/// as distinct in a unique index, so business-wide targets (branchId null) are
/// not constrained by it; `upsertBusinessTarget` enforces that case in the
/// action layer instead.
model BusinessTarget {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  branchId    String?
  name        String
  month       String
  targetAmountCents Int
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([branchId, month])
  @@index([userId, month])
  @@index([businessId, month])
}

/// Money the owner takes out of a business for personal use.
///
/// This is modelled as a TRANSFER, not as an expense plus an income. That is the
/// whole point of the row: a draw leaves the business and arrives in the
/// personal pot, so in a combined view it nets to zero and can never be counted
/// twice as external money. Creating a personal `Income` row and separately
/// reducing business cash is exactly the mistake this model exists to prevent -
/// the engine reads these rows directly (see `ownerDraws` in AnalysisInput)
/// instead of pretending a transfer is revenue.
model OwnerDraw {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  /// Positive integer cents leaving the business.
  amountCents Int
  date        DateTime
  notes       String?
  /// Cheque or transfer reference the owner kept for their own records.
  reference   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, deletedAt])
  @@index([businessId, date])
}

model Letter {
  id           String   @id @default(cuid())
  userId       String
  businessId   String?
  templateKey  String // "bank" | "offer" | "personal" | "company"
  title        String
  variablesJson String
  storedName   String?
  bodyText     String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Agreement {
  id          String    @id @default(cuid())
  userId      String
  businessId  String?
  title       String
  otherParty  String
  startDate   DateTime
  endDate     DateTime?
  valueCents  Int?
  summary     String?
  documentId  String?
  status      String    @default("draft") // "draft" | "active" | "expired"
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([endDate])
}

model MedicalRecord {
  id          String    @id @default(cuid())
  userId      String
  kind        String // "expense" | "appointment" | "medication"
  date        DateTime  @default(now())
  title       String
  provider    String?
  amountCents Int?
  notes       String?
  nextDoseAt  DateTime?
  completed   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  kind       String // "finance_payment" | "loan" | "pawn_interest" | "goal" | "agreement" | "medical"
  title      String
  dueDate    DateTime
  entityType String?
  entityId   String?
  /// Stable key so re-running the sync never produces a duplicate reminder.
  dedupeKey  String?   @unique
  channel    String    @default("email") // "email" | "sms"
  status     String    @default("pending") // "pending" | "done" | "dismissed"
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([status, dueDate])
}

/// A verified request to close an account. Every record is hard-deleted once
/// the 30-day window in the Personal Data Protection Act has passed.
model DeletionRequest {
  id           String    @id @default(cuid())
  userId       String
  requestedAt  DateTime  @default(now())
  purgeAfter   DateTime
  completedAt  DateTime?
  fileNames    String    @default("[]") // JSON array of vault files to unlink

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purgeAfter, completedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  meta       String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
