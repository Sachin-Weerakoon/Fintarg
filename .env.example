# PostgreSQL is required for development and production (see prisma/schema.prisma).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fintarg?schema=public"

# 32+ byte secret used to sign session cookies and CSRF tokens. Rotate for production.
AUTH_SECRET="dev-only-insecure-secret-change-me-before-deploying-0123456789"

# Local filesystem storage root for the encrypted document vault.
STORAGE_DIR="./storage"

# Origin used for CSRF verification.
APP_ORIGIN="http://localhost:3000"

# Shared secret for the scheduled job routes (/api/cron/*). Sent as
# `Authorization: Bearer <CRON_SECRET>`.
#
# These routes fail CLOSED. /api/cron/maintenance permanently deletes accounts
# whose 30-day window has closed, so leaving this unset does not make them open -
# it makes them return 401. To exercise them from a terminal instead, set
# CRON_ALLOW_OPEN=true *and* leave CRON_SECRET empty. Never set that on a
# deployment that real people can reach.
CRON_SECRET=""
CRON_ALLOW_OPEN=""

# Outbound SMS, used for password reset on mobile-only accounts and for reminders
# where an account has no email address. With SMS_PROVIDER unset, messages are
# written to the server log instead of being sent.
SMS_PROVIDER=""
SMS_ENDPOINT=""
SMS_API_KEY=""

# Outbound email. With MAIL_PROVIDER unset, reminder emails are written to the
# server log instead of being sent. Set these to go live.
MAIL_PROVIDER=""
MAIL_ENDPOINT=""
MAIL_API_KEY=""

# Subscription billing (FR-15 upgrade path).
#
# The plan is moved ONLY by a signature-verified POST to /api/billing/webhook, never
# by the browser returning from checkout. BILLING_WEBHOOK_SECRET is what makes that
# call trustworthy, so it is REQUIRED whenever a real provider is set - an unset
# secret makes the webhook reject everything rather than accept anything.
#
# BILLING_PROVIDER accepts "log" (default, no gateway) or the name of a provider you
# implement in src/lib/billing/provider.ts. Naming an unimplemented provider is an
# error on purpose: it must not silently behave like "log" and grant a paid plan.
BILLING_PROVIDER="log"
BILLING_ENABLED=""
BILLING_WEBHOOK_SECRET=""
